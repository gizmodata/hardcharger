{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hardcharger",
  "version": "2.3.0",
  "identifier": "com.gizmodata.hardcharger.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hardcharger",
        "width": 1180,
        "height": 880,
        "minWidth": 860,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "GizmoData LLC",
    "category": "DeveloperTool",
    "shortDescription": "Fast, secure, remote DuckDB. On your desktop.",
    "copyright": "Copyright © GizmoData LLC. Hardcharger™ and GizmoData™ are trademarks of GizmoData LLC.",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/hardcharger-server",
      "binaries/hardcharger"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 440
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxQTYxQjgxNTczNUZENUIKUldSYi9UVlhnUnVtY1dtTWdubUFVY0hIMnQ5UFU3ZXNZaXJqdUIrTll5b1dRdTEvMGtoUk4wRUIK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
