# THIRD_PARTY_NOTICES.md (the repository's top level, written by
# server/scripts/third-party-notices.py), embedded in hardcharger-server and hardcharger as
# hardcharger::ThirdPartyNotices(), which their --licenses prints: a binary copied out of
# its release archive still carries the notices of what it contains. A byte array, not a
# string literal: MSVC limits string literals to 64 KiB.

set(_notices_file "${CMAKE_CURRENT_SOURCE_DIR}/../THIRD_PARTY_NOTICES.md")
if(NOT EXISTS "${_notices_file}")
  message(FATAL_ERROR "${_notices_file} is missing (server/scripts/third-party-notices.py writes it)")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_notices_file}")

set(_notices_dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
function(_notices_write path content)
  # Rewritten only when it changes, so a reconfigure doesn't rebuild what includes it.
  file(WRITE "${path}.new" "${content}")
  file(COPY_FILE "${path}.new" "${path}" ONLY_IF_DIFFERENT)
  file(REMOVE "${path}.new")
endfunction()

_notices_write("${_notices_dir}/third_party_notices.hpp" [=[
// Generated by server/cmake/third_party_notices.cmake. Do not edit.
#pragma once

#include <string_view>

namespace hardcharger {

// THIRD_PARTY_NOTICES.md: the third-party software in this binary and its licences.
std::string_view ThirdPartyNotices();

}  // namespace hardcharger
]=])

file(READ "${_notices_file}" _notices_hex HEX)
file(SIZE "${_notices_file}" _notices_size)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _notices_bytes "${_notices_hex}")
string(REGEX REPLACE "((0x..,){32})" "\\1\n" _notices_bytes "${_notices_bytes}")
_notices_write("${_notices_dir}/third_party_notices.cc" "\
// Generated by server/cmake/third_party_notices.cmake from THIRD_PARTY_NOTICES.md. Do not edit.
#include \"third_party_notices.hpp\"

namespace hardcharger {
namespace {
const unsigned char kNotices[] = {
${_notices_bytes}};
}  // namespace

std::string_view ThirdPartyNotices() {
  return {reinterpret_cast<const char*>(kNotices), ${_notices_size}};
}

}  // namespace hardcharger
")

add_library(hardcharger_notices STATIC "${_notices_dir}/third_party_notices.cc")
target_include_directories(hardcharger_notices PUBLIC "${_notices_dir}")
message(STATUS "Third-party notices: embedded ${_notices_size} bytes of THIRD_PARTY_NOTICES.md")
