{
  "about": "The third-party code Hardcharger's release binaries contain. server/scripts/third-party-notices.py writes THIRD_PARTY_NOTICES.md from this file and the texts/ it fetched; its --check (CI) fails when a recipe pins another version than `pins` records, when a dependency is in no component, or when THIRD_PARTY_NOTICES.md is not what this file generates.",
  "pins": {
    "duckdb_commit": {
      "file": "third_party/warp-sql/cpp/scripts/build-duckdb.sh",
      "pattern": "^DUCKDB_COMMIT=([0-9a-f]{40})$",
      "value": "d54cbbe3df17e8e5ce68312f483b4155836112aa"
    },
    "duckdb_version": {
      "file": "third_party/warp-sql/cpp/scripts/build-duckdb.sh",
      "pattern": "^DUCKDB_VERSION_NAME=(\\S+)$",
      "value": "v2.0.0"
    },
    "httpfs": {
      "file": "server/scripts/duckdb-extensions.cmake",
      "pattern": "duckdb_extension_load\\(httpfs\\s+GIT_URL \\S+\\s+GIT_TAG ([0-9a-f]{40})",
      "value": "77392a72077a85897db2519fae11e2c0da972b8a"
    },
    "ducklake": {
      "file": "server/scripts/duckdb-extensions.cmake",
      "pattern": "duckdb_extension_load\\(ducklake\\s+GIT_URL \\S+\\s+GIT_TAG ([0-9a-f]{40})",
      "value": "417a9117f590e8141742ac0579d02f6a90162e37"
    },
    "postgres_scanner": {
      "file": "server/scripts/duckdb-extensions.cmake",
      "pattern": "duckdb_extension_load\\(postgres_scanner\\s+GIT_URL \\S+\\s+GIT_TAG ([0-9a-f]{40})",
      "value": "c0f5a3c0c4b68b02afbf669d36d7f0e503985c88"
    },
    "arrow": {
      "file": "third_party/warp-sql/cpp/scripts/build-arrow.sh",
      "pattern": "^ARROW_TAG=apache-arrow-(\\S+)$",
      "value": "26.0.0"
    },
    "boost": {
      "file": "third_party/warp-sql/cpp/CMakeLists.txt",
      "pattern": "boost-([0-9.]+)-cmake\\.tar\\.xz",
      "value": "1.92.0"
    },
    "openssl": {
      "file": "server/scripts/deps-openssl.sh",
      "pattern": "^OPENSSL_VERSION=(\\S+)$",
      "value": "3.5.9"
    },
    "jwt_cpp": {
      "file": "server/CMakeLists.txt",
      "pattern": "Thalhammer/jwt-cpp/archive/refs/tags/v([0-9.]+)\\.tar\\.gz",
      "value": "0.7.2"
    },
    "yaml_cpp": {
      "file": "server/CMakeLists.txt",
      "pattern": "jbeder/yaml-cpp/archive/refs/tags/yaml-cpp-([0-9.]+)\\.tar\\.gz",
      "value": "0.9.0"
    },
    "zlib": {
      "file": "server/CMakeLists.txt",
      "pattern": "madler/zlib/releases/download/v([0-9.]+)/",
      "value": "1.3.2"
    },
    "replxx": {
      "file": "server/scripts/build-replxx.sh",
      "pattern": "^REPLXX_TAG=release-(\\S+)$",
      "value": "0.0.4"
    },
    "roaring": {
      "file": "server/scripts/build-extension-deps.sh",
      "pattern": "^ROARING_VERSION=(\\S+)$",
      "value": "5.2.4"
    },
    "postgres": {
      "file": "server/scripts/build-extension-deps.sh",
      "pattern": "^POSTGRES_VERSION=(\\S+)$",
      "value": "18.6"
    },
    "curl": {
      "file": "server/scripts/build-extension-deps.sh",
      "pattern": "^CURL_VERSION=(\\S+)$",
      "value": "8.23.0"
    }
  },
  "derived": {
    "postgres_tag": {
      "from": "postgres",
      "replace": [
        ".",
        "_"
      ]
    },
    "curl_tag": {
      "from": "curl",
      "replace": [
        ".",
        "_"
      ]
    }
  },
  "not_shipped": {
    "fetchcontent": {
      "googletest": "the unit tests only"
    }
  },
  "components": [
