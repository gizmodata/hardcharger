 namespace duckdb {
 
+// Hardcharger: the STORAGE_VERSION a DuckDB metadata file is attached with. An existing
+// file keeps its own storage version (no STORAGE_VERSION: DuckDB takes it from the file's
+// header), so a DuckLake that another DuckDB release created stays readable by that
+// release after this server writes to it; 'latest' would upgrade the file at its next
+// checkpoint. A new file gets the instance's storage_compatibility_version when one was
+// set (DuckDB applies it to new files), and 'latest' otherwise, as upstream does.
+static string HardchargerMetadataStorageVersion(ClientContext &context, const string &metadata_path) {
+	string path = metadata_path;
+	string prefix;
+	DBPathAndType::ExtractExtensionPrefix(path, prefix);
+	if (path.empty() || path == IN_MEMORY_PATH) {
+		return "latest";
+	}
+	bool exists;
+	try {
+		auto &fs = FileSystem::GetFileSystem(context);
+		exists = fs.FileExists(fs.ExpandPath(path));
+	} catch (...) {
+		// unknown: leave the version to the file (or to DuckDB's default for a new one)
+		return string();
+	}
+	if (exists || DBConfig::GetConfig(context).options.storage_compatibility.manually_set) {
+		return string();
+	}
+	return "latest";
+}
