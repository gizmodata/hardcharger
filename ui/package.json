{
  "name": "hardcharger-ui",
  "description": "The web UI for Hardcharger: a static single-page app the server serves at /ui, talking Warp SQL to its own origin.",
  "author": "GizmoData LLC",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gizmodata/hardcharger.git",
    "directory": "ui"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-dist.mjs",
    "package": "node scripts/package-dist.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p test/e2e/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "vendor:verify": "node scripts/vendor-warp-sql.mjs --verify"
  },
  "dependencies": {
    "@gizmodata/warp-sql": "file:vendor/gizmodata-warp-sql-0.1.0.tgz",
    "apache-arrow": "^21.2.0",
    "lucide-react": "^1.59.0",
    "monaco-editor": "^0.57.0",
    "parquet-wasm": "^0.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@peculiar/x509": "^2.2.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
